{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KeepExistingMediaReads",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::plio-prod-assets/images/*",
        "arn:aws:s3:::plio-prod-assets/avatars/*"
      ]
    }
  ]
}
